{
  "name": "bitsnap-react",
  "version": "1.10.0",
  "description": "This is Bitsnap React library for easy integration with any website which is using React framework",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/write-version.mjs && tsup",
    "test:returns-ssr": "pnpm build && node --test test/returns-widget.ssr.test.cjs",
    "test:catalog-ssr": "pnpm build && node --test test/catalog.ssr.test.cjs",
    "test:course-ssr": "pnpm build && node --test test/course.ssr.test.cjs",
    "build:publish": "pnpm build --env.publish",
    "clean": "rimraf ./dist",
    "dev": "node scripts/write-version.mjs && tsup --watch",
    "dev:publish": "pnpm dev --env.publish",
    "test": "tsup src/components/checkout/appearance.test.ts src/components/checkout/texts.test.ts src/components/checkout/buy-error.test.ts src/components/checkout/cart-buy-error.test.tsx src/lib/appearance-core.test.ts src/lib/texts.test.ts src/components/returns/appearance.test.ts src/components/returns/texts.test.ts src/components/returns/errors.test.ts src/components/returns/money.test.ts src/components/returns/session-storage.test.ts src/components/returns/state-machine.test.ts src/components/returns/selection.test.ts src/components/returns/legacy.test.ts src/panel/returns-appearance.test.ts src/components/products/appearance.test.ts src/components/products/texts.test.ts src/components/products/format.test.ts src/components/products/fetch.test.ts src/components/products/useProducts.test.ts src/components/products/cart-target.test.ts src/components/checkout/cart-items.test.ts src/components/checkout/pending-order.test.ts src/components/checkout/quantity.test.ts src/components/checkout/cart-a11y.test.tsx src/course/logic.test.ts src/course/accent.test.ts src/course/texts.test.ts src/course/datasource.test.ts src/course/sanitize.test.ts src/course/VideoPlayer.test.tsx src/course/PanelCourse.test.tsx src/consent/core/cookie.test.ts src/consent/core/texts.test.ts src/consent/core/activate.test.ts src/consent/core/gcm.test.ts src/consent/core/contrast.test.ts src/consent/core/controller.test.ts src/consent/embed.test.ts src/consent/react.test.tsx src/analytics/core.test.ts src/analytics/embed.test.ts src/analytics/instrument.test.tsx src/analytics/page-views.test.tsx src/analytics/visitor.test.ts src/components/checkout/visitor-header.test.ts src/components/products/impressions.test.ts src/components/products/ProductList.analytics.test.tsx src/components/checkout/cart-analytics.test.tsx src/components/checkout/apple-pay-analytics.test.tsx src/components/notifications/notifications-analytics.test.tsx src/components/returns/returns-analytics.test.tsx src/panel/panel-analytics.test.tsx src/course/course-analytics.test.tsx --format esm --out-dir .test-dist --no-config --external jsdom --silent && node --test --test-force-exit \".test-dist/**/*.test.mjs\"",
    "test:types": "tsc -p test/consumer/tsconfig.json",
    "test:package": "node test/consumer/verify-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmems/bitsnap-react.git"
  },
  "keywords": ["bitsnap", "checkout", "shop", "ecommerce"],
  "author": "Piotr Michalik",
  "license": "SEE LICENSE IN LICENSE file",
  "bugs": {
    "url": "https://github.com/emmems/bitsnap-react/issues"
  },
  "sideEffects": ["*.css"],
  "files": ["dist"],
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/emmems/bitsnap-react#readme",
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.3",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.0",
    "@connectrpc/connect": "^2.1.0",
    "@connectrpc/connect-query": "^2.1.0",
    "@connectrpc/connect-web": "^2.1.0",
    "@formkit/auto-animate": "^0.8.2",
    "@google-pay/button-react": "^3.2.1",
    "@inpost-pay/widget": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/postcss": "^4.2.1",
    "@tanstack/react-query": "^5.90.9",
    "@types/applepayjs": "^14.0.9",
    "@zootools/email-spell-checker": "^1.12.0",
    "add": "^2.0.6",
    "apple-pay-button": "^1.2.1",
    "checkbox": "^0.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dlx": "^0.2.1",
    "dompurify": "^3.4.17",
    "hls.js": "^1.6.15",
    "input-otp": "^1.4.2",
    "label": "^0.2.2",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "pnpm": "^10.23.0",
    "postcss-prefix-selector": "^2.1.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-phone-number-input": "^3.4.13",
    "shadcn": "^3.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.2.1",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.0.6",
    "zod": "4.1.12",
    "zustand": "^5.0.8"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./models": {
      "import": {
        "types": "./dist/models.d.mts",
        "default": "./dist/models.mjs"
      },
      "require": {
        "types": "./dist/models.d.ts",
        "default": "./dist/models.js"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.mts",
        "default": "./dist/internal.mjs"
      },
      "require": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      }
    },
    "./dist/index.css": {
      "import": "./dist/index.css",
      "require": "./dist/index.css"
    },
    "./errors": {
      "import": {
        "types": "./dist/errors.d.mts",
        "default": "./dist/errors.mjs"
      },
      "require": {
        "types": "./dist/errors.d.ts",
        "default": "./dist/errors.js"
      }
    },
    "./returns": {
      "import": {
        "types": "./dist/returns.d.mts",
        "default": "./dist/returns.mjs"
      },
      "require": {
        "types": "./dist/returns.d.ts",
        "default": "./dist/returns.js"
      }
    },
    "./catalog": {
      "import": {
        "types": "./dist/catalog.d.mts",
        "default": "./dist/catalog.mjs"
      },
      "require": {
        "types": "./dist/catalog.d.ts",
        "default": "./dist/catalog.js"
      }
    },
    "./course": {
      "import": {
        "types": "./dist/course.d.mts",
        "default": "./dist/course.mjs"
      },
      "require": {
        "types": "./dist/course.d.ts",
        "default": "./dist/course.js"
      }
    },
    "./consent": {
      "import": {
        "types": "./dist/consent.d.mts",
        "default": "./dist/consent.mjs"
      },
      "require": {
        "types": "./dist/consent.d.ts",
        "default": "./dist/consent.js"
      }
    },
    "./analytics": {
      "import": {
        "types": "./dist/analytics.d.mts",
        "default": "./dist/analytics.mjs"
      },
      "require": {
        "types": "./dist/analytics.d.ts",
        "default": "./dist/analytics.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "models": ["./dist/models.d.ts"],
      "internal": ["./dist/internal.d.ts"],
      "errors": ["./dist/errors.d.ts"],
      "returns": ["./dist/returns.d.ts"],
      "catalog": ["./dist/catalog.d.ts"],
      "course": ["./dist/course.d.ts"],
      "consent": ["./dist/consent.d.ts"],
      "analytics": ["./dist/analytics.d.ts"]
    }
  }
}
