{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["react"],
    "baseUrl": ".",
    "paths": {
      "bitsnap-react": ["../../dist/index.d.ts"],
      "bitsnap-react/*": ["../../dist/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
